# ─────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy to .env and fill in real values before running.
# IMPORTANT: .env must NEVER be committed to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Node.js Backend
NODE_ENV=development
NODE_PORT=3000
ALLOWED_ORIGIN=http://localhost

# Python Service
PYTHON_SERVICE_URL=http://python-service:8000

# SECURITY FIX [SEC-004]: Set DEV_MODE=true ONLY in local development.
# When false (default), the Python service will refuse to start if
# RECAPTCHA_SECRET_KEY is not configured — preventing silent CAPTCHA bypass.
DEV_MODE=false

# Database
# SECURITY FIX [SEC-003]: Credentials are no longer hardcoded in docker-compose.yml.
# Use a strong randomly generated password (e.g. openssl rand -base64 32).
DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/company_website
POSTGRES_DB=company_website
POSTGRES_USER=<replace_with_app_username>
POSTGRES_PASSWORD=<replace_with_strong_random_password>

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key_here
COMPANY_EMAIL=info@yourcompany.com

# Google reCAPTCHA v3
# SECURITY FIX [SEC-001]: These keys are injected at deploy time.
# The site key is passed to envsubst when building the frontend Docker image.
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key_here
RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here

# SMTP Fallback (optional)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
